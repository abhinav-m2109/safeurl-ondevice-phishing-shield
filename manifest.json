{
  "manifest_version": 3,
  "name": "SafeURL - On-Device AI Phishing Shield",
  "version": "1.0.0",
  "description": "Privacy-first, on-device AI phishing URL detector with real-time Explainable AI (XAI) risk metrics and plain-English alerts.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "model.onnx",
        "xai_config.json",
        "onnxruntime.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
